# Placeholders only. Configure a dedicated key through a secure setup flow.
# Local paid requests stay off; paid tests and public calls share the hosted ledger.
DATABASE_PATH=./data/atlas.sqlite
# The public origin used by feedback checks. Use the exact HTTPS origin on a host.
APP_ORIGIN=http://127.0.0.1:3000
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
# Set to USD or CNY only after checking the DeepSeek account's billing currency.
AI_BILLING_CURRENCY=
DEEPSEEK_API_KEY=
# Separate random server secret for pseudonymous submission throttling.
AI_THROTTLE_SECRET=
# Signed first-party browser cookie; no visitor account required.
AI_CLIENT_IDENTITY_MODE=browser-session
